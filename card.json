    {
      "name": "🌟 Thẻ Ngang (Ảnh Trái - Chữ Phải) CHỐNG VỠ",
      "html": "<div style=\"display:flex;flex-wrap:wrap;align-items:center;gap:20px;border:1px solid #333;background:rgba(255,255,255,0.03);padding:20px;border-radius:12px;width:100%;margin:15px 0;\"><div style=\"flex:0 0 140px;height:120px;display:flex;align-items:center;justify-content:center;\"><img src=\"https://via.placeholder.com/150\" style=\"max-height:100%;max-width:100%;object-fit:contain;border-radius:10px;\"></div><div style=\"flex:1 1 0%;min-width:200px;display:flex;flex-direction:column;\"><h3 style=\"margin:0 0 10px 0;font-size:20px;color:#00d2ff;\">Tên Công Cụ App</h3><p style=\"font-size:14px;line-height:1.6;color:#bbb;margin:0 0 15px 0;\">Thẻ Media Object chuẩn, ảnh được khóa cứng chiều cao, chữ hiển thị rõ ràng.</p><a href=\"#\" style=\"align-self:flex-start;padding:10px 24px;background:#00bcd4;color:#fff;text-decoration:none;border-radius:8px;font-weight:bold;font-size:13px;\">Tải Xuống</a></div></div>"
    },
    {
      "name": "📄 [THÊM MỚI] Thẻ Văn Bản (Không Có Ảnh)",
      "html": "<div class=\"card-wrap\" style=\"display:flex;gap:20px;flex-wrap:wrap;margin:15px 0;width:100%;\"><div class=\"card\" style=\"flex:1 1 0%;min-width:200px;max-width:100%;display:flex;flex-direction:column;border:1px solid rgba(150,150,150,0.3);background:rgba(150,150,150,0.02);color:inherit;border-radius:10px;overflow:hidden;box-shadow: 0 4px 8px rgba(0,0,0,0.1);\"><div style=\"padding:20px;display:flex;flex-direction:column;flex:1;\"><h3 style=\"margin:0 0 15px 0;font-size:20px;color:#00d2ff;border-bottom:1px solid rgba(150,150,150,0.2);padding-bottom:10px;\">Tiêu đề Văn Bản</h3><p style=\"font-size:14px;line-height:1.6;opacity:0.9;margin:0 0 15px 0;\">Đây là mẫu thẻ không sử dụng hình ảnh. Phù hợp để làm thẻ thông báo, thẻ quy định hoặc bảng liệt kê các thông tin cần sự tối giản.</p><a href=\"#\" style=\"display:inline-block;align-self:flex-start;padding:8px 16px;background:transparent;color:#007bff;text-decoration:none;border:1px solid #007bff;border-radius:5px;font-weight:bold;transition:0.2s;\">Đọc Thêm ➔</a></div></div></div>"
    },
    {
      "name": "💎 Thẻ Bảng Giá Premium (Pricing Card)",
      "html": "<div style=\"display:flex;justify-content:center;width:100%;margin:20px 0;\"><div style=\"flex:1 1 280px;max-width:340px;border:2px solid #00d2ff;background:#18181e;border-radius:16px;padding:30px 24px;text-align:center;box-shadow:0 8px 25px rgba(0,210,255,0.15);display:flex;flex-direction:column;\"><span style=\"background:#00d2ff;color:#000;font-size:12px;font-weight:bold;padding:4px 12px;border-radius:20px;align-self:center;margin-bottom:15px;\">PHỔ BIẾN NHẤT</span><h3 style=\"font-size:22px;margin:0 0 10px 0;color:#fff;\">Gói Chuyên Nghiệp</h3><div style=\"font-size:36px;font-weight:bold;color:#00d2ff;margin-bottom:20px;\">499.000đ<span style=\"font-size:14px;color:#888;\">/tháng</span></div><ul style=\"list-style:none;padding:0;margin:0 0 25px 0;text-align:left;color:#ccc;font-size:14px;line-height:2.2;\"><li>✓ Tất cả tính năng Cơ bản</li><li>✓ Tùy chỉnh Preset không giới hạn</li><li>✓ Hỗ trợ ưu tiên 24/7</li><li>✓ Xuất file HTML/CSS sạch</li></ul><a href=\"#\" style=\"padding:12px 20px;background:#00d2ff;color:#000;text-decoration:none;border-radius:8px;font-weight:bold;margin-top:auto;\">Đăng Ký Ngay</a></div></div>"
    },
    {
      "name": "💬 Thẻ Đánh Giá (Testimonial Card)",
      "html": "<div style=\"background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:12px;padding:20px;margin:15px 0;width:100%;\"><p style=\"font-style:italic;color:#ddd;font-size:14px;line-height:1.6;margin:0 0 15px 0;\">\"Công cụ này giúp mình tiết kiệm 80% thời gian dựng UI HTML. Mẫu thẻ chuẩn không lo loang bể giao diện!\"</p><div style=\"display:flex;align-items:center;gap:12px;\"><div style=\"width:45px;height:45px;border-radius:50%;overflow:hidden;flex:0 0 45px;\"><img src=\"https://via.placeholder.com/100\" style=\"width:100%;height:100%;object-fit:cover;\"></div><div><strong style=\"display:block;color:#fff;font-size:14px;\">Nguyễn Văn Developer</strong><span style=\"font-size:12px;color:#888;\">Frontend Lead</span></div></div></div>"
    },
    {
      "name": "📦 1 Lớn (Trái) - 2 Nhỏ (Phải)",
      "html": "<div style=\"display:flex;flex-wrap:wrap;gap:20px;width:100%;margin:15px 0;\"><div style=\"flex:1 1 300px;border:1px solid rgba(255,255,255,0.2);border-radius:8px;display:flex;align-items:flex-start;justify-content:flex-start;min-height:180px;background:rgba(20,20,25,1);padding:15px;\"><div style=\"display:flex;align-items:center;gap:10px;\"><img src=\"https://via.placeholder.com/20\" style=\"width:20px;height:20px;object-fit:cover;\"><span style=\"color:#fff;font-family:sans-serif;font-size:14px;\">Modules T2SPP</span></div></div><div style=\"flex:1 1 300px;display:flex;flex-direction:column;gap:15px;justify-content:center;\"><div style=\"display:flex;align-items:center;justify-content:space-between;background:#1a1c23;border:1px solid rgba(255,255,255,0.1);padding:15px 20px;border-radius:8px;\"><div style=\"font-weight:bold;color:#00d2ff;font-family:sans-serif;\">👩 Giọng Nữ</div><a href=\"#\" style=\"padding:8px 20px;background:transparent;color:#00d2ff;text-decoration:none;border:1px solid #00d2ff;border-radius:5px;font-size:13px;font-weight:bold;\">Tải Xuống</a></div><div style=\"display:flex;align-items:center;justify-content:space-between;background:#1a1c23;border:1px solid rgba(255,255,255,0.1);padding:15px 20px;border-radius:8px;\"><div style=\"font-weight:bold;color:#00d2ff;font-family:sans-serif;\">👨 Giọng Nam</div><a href=\"#\" style=\"padding:8px 20px;background:transparent;color:#00d2ff;text-decoration:none;border:1px solid #00d2ff;border-radius:5px;font-size:13px;font-weight:bold;\">Tải Xuống</a></div></div></div>"
    },
    {
      "name": "👤 Thẻ Hồ Sơ (User Profile)",
      "html": "<div style=\"background:rgba(255,255,255,0.03);border:1px solid rgba(150,150,150,0.2);border-radius:12px;padding:20px;text-align:center;width:100%;max-width:280px;margin:15px auto;box-shadow:0 4px 10px rgba(0,0,0,0.1);\"><img src=\"https://via.placeholder.com/100\" style=\"width:80px;height:80px;border-radius:50%;object-fit:cover;border:3px solid #00d2ff;margin-bottom:15px;\"><h3 style=\"margin:0 0 5px 0;font-size:18px;color:#fff;\">Trần Văn B</h3><p style=\"margin:0 0 15px 0;font-size:13px;color:#888;\">Chuyên gia UI/UX</p><div style=\"display:flex;gap:10px;justify-content:center;\"><a href=\"#\" style=\"padding:6px 12px;background:#00d2ff;color:#000;text-decoration:none;border-radius:20px;font-size:12px;font-weight:bold;\">Theo Dõi</a><a href=\"#\" style=\"padding:6px 12px;background:transparent;color:#00d2ff;border:1px solid #00d2ff;text-decoration:none;border-radius:20px;font-size:12px;font-weight:bold;\">Nhắn Tin</a></div></div>"
    },
    {
      "name": "🚀 Thẻ Tính Năng (Feature Card)",
      "html": "<div style=\"flex:1 1 250px;background:#1a1c23;border-top:4px solid #ff007f;border-radius:8px;padding:25px;margin:15px;box-shadow:0 5px 15px rgba(0,0,0,0.2);transition:0.3s;\"><div style=\"font-size:30px;margin-bottom:15px;\">⚡</div><h3 style=\"margin:0 0 10px 0;color:#fff;font-size:18px;\">Tối Ưu Tốc Độ</h3><p style=\"color:#aaa;font-size:14px;line-height:1.6;margin:0 0 20px 0;\">Hệ thống được thiết kế để render cực nhanh, mang lại trải nghiệm mượt mà cho người dùng cuối.</p><a href=\"#\" style=\"color:#ff007f;text-decoration:none;font-weight:bold;font-size:13px;\">Khám phá ngay ➔</a></div>"
    },
    {
      "name": "⚠️ Thẻ Thông Báo / Cảnh Báo",
      "html": "<div style=\"display:flex;align-items:flex-start;gap:15px;background:rgba(255,193,7,0.1);border-left:4px solid #ffc107;padding:15px 20px;border-radius:0 8px 8px 0;margin:15px 0;width:100%;\"><div style=\"font-size:24px;\">🔔</div><div><h4 style=\"margin:0 0 5px 0;color:#ffc107;font-size:16px;\">Lưu ý quan trọng</h4><p style=\"margin:0;color:#ddd;font-size:14px;line-height:1.5;\">Vui lòng sao lưu dữ liệu trước khi thực hiện cập nhật phiên bản mới để tránh mất mát thông tin.</p></div></div>"
    }
  ]
